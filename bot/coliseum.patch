+	onDragOver(event: DragEvent) {
+		event.preventDefault();
+	}
+
+	async onFileDropped(event: DragEvent) {
+		event.preventDefault();
+		const file = event.dataTransfer?.files?.[0];
+		if (file) {
+			await this.loadLocalFile(file);
+		}
+	}
+
+	async onFileSelected(event: Event) {
+		const file = (event.target as HTMLInputElement).files?.[0];
+		if (file) {
+			await this.loadLocalFile(file);
+		}
+	}
+
+	// Reads a local replay and feeds it straight into the renderer, bypassing the
+	// reviewId -> server download path. Accepts HSReplay XML (.xml / zipped), and
+	// HDT .hdtreplay / raw Power.log, which are converted to XML in-browser.
+	private async loadLocalFile(file: File) {
+		this.loadError = null;
+		try {
+			const lower = file.name.toLowerCase();
+			let content: string | undefined;
+			if (lower.endsWith('.zip') || lower.endsWith('.hdtreplay')) {
+				const zip = await loadAsync(file);
+				const entry = Object.keys(zip.files)[0];
+				content = await zip.file(entry)?.async('string');
+			} else {
+				content = await file.text();
+			}
+			if (!content) {
+				throw new Error('empty replay file');
+			}
+
+			// HDT stores the raw Hearthstone Power.log, not HSReplay XML. Convert it in-browser.
+			let xml: string;
+			if (this.looksLikeXml(content)) {
+				xml = content;
+			} else {
+				this.loadStatus = 'Converting Hearthstone log (first time downloads the converter)…';
+				if (!(this.cdr as ViewRef).destroyed) {
+					this.cdr.markForCheck();
+				}
+				xml = await this.convertPowerLog(content);
+			}
+
+			// Replays are a single ~18MB line; the parser's regex `.*` backtracks across the whole
+			// line and overflows Firefox's regex stack ("too much recursion"). Break tags onto
+			// their own lines so `.*` is bounded per tag (saxes ignores inter-element whitespace).
+			xml = xml.replace(/></g, '>\n<');
+			this.loadStatus = null;
+			this.replayXml = xml;
+			this.localMode = false;
+		} catch (e: any) {
+			console.error('could not load local replay', e);
+			this.loadStatus = null;
+			this.loadError = e?.message ?? 'could not read file';
+		}
+		if (!(this.cdr as ViewRef).destroyed) {
+			this.cdr.markForCheck();
+		}
+	}
+
+	private looksLikeXml(content: string): boolean {
+		const head = content.slice(0, 200).trimStart();
+		return head.startsWith('<?xml') || head.startsWith('<HSReplay') || head.includes('<Game');
+	}
+
+	// Convert a raw Hearthstone Power.log to HSReplay XML using HearthSim's Python
+	// parser, run in the browser via Pyodide (loaded on demand, only for log files).
+	private async convertPowerLog(log: string): Promise<string> {
+		const py = await this.getPyodide();
+		py.globals.set('LOG_TEXT', log);
+		const xml: string = await py.runPythonAsync(`import io
+from hslog import LogParser
+from hsreplay.document import HSReplayDocument
+_p = LogParser(); _p.read(io.StringIO(LOG_TEXT)); _p.flush()
+_xml = HSReplayDocument.from_parser(_p, build=None).to_xml()
+"\\n".join(l for l in _xml.splitlines() if not l.lstrip().startswith("<!DOCTYPE"))`);
+		if (!xml || !xml.includes('<Game ')) {
+			throw new Error('could not parse Hearthstone log (empty or unsupported)');
+		}
+		return xml;
+	}
+
+	private getPyodide(): Promise<any> {
+		if (!this.pyodidePromise) {
+			this.pyodidePromise = (async () => {
+				await this.loadScript('https://cdn.jsdelivr.net/pyodide/v0.26.2/full/pyodide.js');
+				const py = await (window as any).loadPyodide();
+				await py.loadPackage('micropip');
+				// setuptools: hsreplay imports pkg_resources at import time.
+				await py.runPythonAsync(`import micropip
+await micropip.install(['setuptools', 'hsreplay'])`);
+				return py;
+			})();
+		}
+		return this.pyodidePromise;
+	}
+
+	private loadScript(src: string): Promise<void> {
+		return new Promise((resolve, reject) => {
+			if (document.querySelector(`script[src="${src}"]`)) {
+				resolve();
+				return;
+			}
+			const s = document.createElement('script');
+			s.src = src;
+			s.onload = () => resolve();
+			s.onerror = () => reject(new Error('failed to load ' + src));
+			document.head.appendChild(s);
+		});
+	}
+
